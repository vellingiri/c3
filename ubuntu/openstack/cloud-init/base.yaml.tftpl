#cloud-config
hostname: ${hostname}
fqdn: ${fqdn}
manage_etc_hosts: true
ssh_pwauth: true
disable_root: false

write_files:
  - path: /etc/resolv.conf.static
    content: |
      search ${domain}
      nameserver ${dns_server}

runcmd:
  # Pin the hostname AFTER cloud-init has set it, so later boots never rename the
  # node (a renamed k8s node can no longer register with the API server).
  - "echo 'preserve_hostname: true' > /etc/cloud/cloud.cfg.d/99-keep-hostname.cfg"
  - touch /root/.hushlogin /home/ubuntu/.hushlogin
  # keep the journal across reboots, so a slow or stuck shutdown can be read afterwards (docs/c3-reboot.md)
  - mkdir -p /var/log/journal && systemd-tmpfiles --create --prefix /var/log/journal && systemctl restart systemd-journald
  - chown ubuntu:ubuntu /home/ubuntu/.hushlogin
  - unlink /etc/resolv.conf || true
  - cp /etc/resolv.conf.static /etc/resolv.conf
  - apt-get update
  # c3:/share (NFS) on every VM; automounted on first access, never blocks boot (nofail)
  - DEBIAN_FRONTEND=noninteractive apt-get install -y nfs-common
  - mkdir -p /share
  - grep -q "^192.168.2.2:/share " /etc/fstab || echo "192.168.2.2:/share /share nfs4 rw,vers=4.2,hard,_netdev,nofail,x-systemd.automount,x-systemd.idle-timeout=600 0 0" >> /etc/fstab
  - systemctl daemon-reload && systemctl restart share.automount
