#cloud-config
# A further control-plane node of an HA cluster (docs/k8s-ha-control-plane.md). It joins through the cluster's API load balancer using the
# control-plane join command that the first controller publishes on the NFS share (cloud-init/files/k8s-publish-join.sh), and is added to the
# load balancer's members by the reconciler on c3 (scripts/k8s-api-lb-reconciler.py). Nothing is typed by hand.
write_files:
  - path: /usr/local/sbin/etcd-snapshot
    permissions: '0755'
    content: |
      ${indent(6, etcd_snapshot_script)}
  - path: /etc/systemd/system/etcd-snapshot.service
    content: |
      ${indent(6, etcd_snapshot_service)}
  - path: /etc/systemd/system/etcd-snapshot.timer
    content: |
      ${indent(6, etcd_snapshot_timer)}
  - path: /etc/default/etcd-snapshot
    content: |
      REMOTE_DIR=/nfsshare/etcd-backups/${cluster_name}
  - path: /etc/k8s-cluster-name
    content: |
      ${cluster_name}
  - path: /usr/local/sbin/k8s-publish-join
    permissions: '0755'
    content: |
      ${indent(6, k8s_publish_join_script)}
  - path: /etc/systemd/system/k8s-publish-join.service
    content: |
      ${indent(6, k8s_publish_join_service)}
  - path: /etc/systemd/system/k8s-publish-join.timer
    content: |
      ${indent(6, k8s_publish_join_timer)}

runcmd:
  - echo "alias k='kubectl'" | tee -a /root/.bashrc /home/ubuntu/.bashrc
  # wait for the first controller to publish the control-plane join command (it refreshes it every hour)
  - for i in $(seq 1 180); do [ -f /nfsshare/join-cp-${cluster_name}.sh ] && break; sleep 10; done
  # control-plane nodes created together join one after the other (etcd takes one new member at a time): per-node var join_delay, in seconds
  - sleep ${join_delay}
  - |
    LOCAL_IP=$(curl -s http://169.254.169.254/latest/meta-data/local-ipv4)
    for i in 1 2 3; do
      bash /nfsshare/join-cp-${cluster_name}.sh --apiserver-advertise-address "$LOCAL_IP" --cri-socket unix:///run/containerd/containerd.sock && break
      kubeadm reset -f; sleep 30
    done
  - mkdir -p /home/ubuntu/.kube /root/.kube
  - cp /etc/kubernetes/admin.conf /home/ubuntu/.kube/config
  - cp /etc/kubernetes/admin.conf /root/.kube/config
  - chown ubuntu:ubuntu /home/ubuntu/.kube/config
  - systemctl daemon-reload && systemctl enable --now etcd-snapshot.timer k8s-publish-join.timer
  # resolvConf: /etc/resolv.conf (the static file with our DNS server, 192.168.2.2), not systemd-resolved's, which on a fresh VM lists only the subnet's 8.8.8.8:
  # host-network pods (kube-proxy, calico) then cannot resolve names like api.<env>.rdulinux.com and a new node never becomes Ready (found on the cka control-plane nodes).
  # kubelet graceful node shutdown (see k8s-controller.yaml.tftpl)
  - "sed -i -e 's/^shutdownGracePeriod: 0s/shutdownGracePeriod: 30s/' -e 's/^shutdownGracePeriodCriticalPods: 0s/shutdownGracePeriodCriticalPods: 10s/' -e 's#^resolvConf: .*#resolvConf: /etc/resolv.conf#' /var/lib/kubelet/config.yaml && systemctl restart kubelet"
