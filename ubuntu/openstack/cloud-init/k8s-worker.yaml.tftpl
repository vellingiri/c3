#cloud-config
runcmd:
  # workers join once the controller has published /nfsshare/join-${cluster_name}.sh
  - for i in $(seq 1 60); do [ -f /nfsshare/join-${cluster_name}.sh ] && break; sleep 10; done
  # retry: a single transient failure (API server briefly unreachable) must not leave the worker out
  - 'for i in 1 2 3 4 5; do bash /nfsshare/join-${cluster_name}.sh && break; kubeadm reset -f; sleep 30; done'
  # resolvConf: /etc/resolv.conf (the static file with our DNS server, 192.168.2.2), not systemd-resolved's, which on a fresh VM lists only the subnet's 8.8.8.8:
  # host-network pods (kube-proxy, calico) then cannot resolve names like api.<env>.rdulinux.com and a new node never becomes Ready (found on the cka control-plane nodes).
  # kubelet graceful node shutdown: on a host reboot/ACPI power-off the kubelet stops the pods (30 s) while the network and the NFS mounts are still up.
  # Without it the pods' processes were killed after the network was gone, hung, and a worker took ~4.5 min to power off (docs/c3-reboot.md).
  - "sed -i -e 's/^shutdownGracePeriod: 0s/shutdownGracePeriod: 30s/' -e 's/^shutdownGracePeriodCriticalPods: 0s/shutdownGracePeriodCriticalPods: 10s/' -e 's#^resolvConf: .*#resolvConf: /etc/resolv.conf#' /var/lib/kubelet/config.yaml && systemctl restart kubelet"
