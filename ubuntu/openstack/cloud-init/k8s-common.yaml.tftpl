#cloud-config
write_files:
  - path: /etc/modules-load.d/k8s.conf
    content: |
      overlay
      br_netfilter
  - path: /etc/sysctl.d/k8s.conf
    content: |
      net.bridge.bridge-nf-call-iptables=1
      net.bridge.bridge-nf-call-ip6tables=1
      net.ipv4.ip_forward=1
  # kubelet must hand pods the static resolver file (our DNS server 192.168.2.2), not systemd-resolved's (a fresh VM lists only the subnet's 8.8.8.8): host-network pods such as
  # kube-proxy and calico resolve api.<env>.rdulinux.com with it. Set BEFORE kubeadm init/join so the first pods already have it (pods keep the resolver they started with;
  # changing it later needed their restart: found on the prod control-plane nodes, docs/k8s-ha-control-plane.md).
  - path: /etc/default/kubelet
    content: |
      KUBELET_EXTRA_ARGS=--resolv-conf=/etc/resolv.conf
  # The pod network 192.168.0.0/16 contains our DNS server 192.168.2.2, so Calico does not masquerade pod traffic to it (the destination counts as "inside the pods' range"): CoreDNS
  # queries then leave the VM with a pod source address and OpenStack drops them (pods could not resolve github.com or any outside name; found 2026-10-22). Masquerade that one destination.
  - path: /etc/systemd/system/pod-dns-masq.service
    content: |
      [Unit]
      Description=Masquerade pod traffic to the lab DNS server (pod CIDR overlaps 192.168.2.0/24)
      After=network-online.target
      Wants=network-online.target
      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/bin/sh -c 'iptables -t nat -C POSTROUTING -s 192.168.0.0/16 -d 192.168.2.2 -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING 1 -s 192.168.0.0/16 -d 192.168.2.2 -j MASQUERADE'
      [Install]
      WantedBy=multi-user.target
  - path: /etc/crictl.yaml
    content: |
      runtime-endpoint: unix:///run/containerd/containerd.sock
      image-endpoint: unix:///run/containerd/containerd.sock
      timeout: 10

runcmd:
  - swapoff -a
  - sed -i '/swap/d' /etc/fstab
  - modprobe overlay
  - modprobe br_netfilter
  - sysctl --system
  - apt-get install -y containerd apt-transport-https ca-certificates curl gpg autofs
  - echo "/- /etc/auto.mount" >> /etc/auto.master
  - echo "/nfsshare -fstype=nfs,rw ${nfs_server}:/nfsshare" > /etc/auto.mount
  - systemctl restart autofs
  - systemctl daemon-reload
  - systemctl enable --now pod-dns-masq.service
  - mkdir -p /etc/containerd /etc/apt/keyrings
  - containerd config default > /etc/containerd/config.toml
  - sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
  - systemctl enable --now containerd
  - systemctl restart containerd
  - curl -fsSL https://pkgs.k8s.io/core:/stable:/${k8s_version}/deb/Release.key | gpg --dearmor -o /etc/apt/keyrings/kubernetes.gpg
  - echo "deb [signed-by=/etc/apt/keyrings/kubernetes.gpg] https://pkgs.k8s.io/core:/stable:/${k8s_version}/deb/ /" > /etc/apt/sources.list.d/kubernetes.list
  - apt-get update
  - apt-get install -y kubelet kubeadm kubectl
  - apt-mark hold kubelet kubeadm kubectl
